"""Reconciliation job for {{ spec.entity }}: count + key + attribute-hash compare."""

from pyspark.sql import SparkSession, functions as F

SPEC_ID = {{ spec.spec_id | pyStr }}
SPEC_VERSION = {{ spec.spec_version }}
SOURCE_TABLE = {{ spec.source.entity | pyStr }}
TARGET_TABLE = {{ spec.target.entity | pyStr }}
CROSSWALK_TABLE = {{ spec.crosswalk.table | pyStr }}

KEYS = [
{% for k in spec.crosswalk.keys %}
    ({{ k.source | pyStr }}, {{ k.target | pyStr }}),
{% endfor %}
]

COMPARE_COLUMNS = [
{% for col in spec.columns %}
{% if col.compare.enabled %}
    {
        "source": {{ col.name | pyStr }},
