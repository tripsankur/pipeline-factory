# generated_by: {{ tag.generated_by }}
# spec_id: {{ tag.spec_id }}
# spec_version: {{ tag.spec_version }}
# DO NOT EDIT — rendered from the approved spec; changes belong in the spec.
#
# Ingestion naming standard:
#   batch  = one scheduled bulk batch per source system (all its tables ride together)
#   nrt    = near-real-time flow group per source (cdc/streaming entities)
#   flow   = brnz_{source}_{entity}_{mode}
ingestion:
  batch: {{ ingest.batch }}
  mode: {{ ingest.mode }}
  transport: {{ spec.ingestion.transport }}
  source_system: {{ spec.source.system }}
  flows:
    - name: {{ ingest.flow }}
      entity: {{ spec.entity }}
      source_object: {{ spec.ingestion.source_object }}
      ingestion_mode: {{ spec.ingestion.mode }}
{% if spec.ingestion.cursor_column %}
      cursor_column: {{ spec.ingestion.cursor_column }}
{% endif %}
      destination:
        table: {{ spec.source.entity }}
      table_properties:
        generated_by: {{ tag.generated_by }}
        spec_id: {{ tag.spec_id }}
        spec_version: "{{ tag.spec_version }}"
